@model SFA.DAS.Campaign.Domain.Content.CtaPanel
@{
    if (Model == null)
    {
        return;
    }

    // Set by the hub view. ViewBag.Section is not usable here: layouts run after the body.
    var brand = ViewData["HubBrand"] as string ?? "apprentices";
    var hasUrl = !string.IsNullOrWhiteSpace(Model.Url);
}
<a class="fiu-panel fiu-panel--@brand fiu-panel--left-align fiu-cta-panel" href="@Model.Url">
    @if (!string.IsNullOrWhiteSpace(Model.Icon))
    {
        <partial name="Hubs/_HubCtaIcon" model="@Model.Icon" />
    }
    <div class="fiu-cta-panel__body">
        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 class="govuk-heading-m govuk-!-margin-0">@Model.Heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
    </div>
    @if (hasUrl)
    {
        <div class="fiu-cta-panel__action">
            <span href="@Model.Url"
                  class="fiu-button fiu-panel__button">
                @(string.IsNullOrWhiteSpace(Model.ButtonText) ? Model.Heading : Model.ButtonText)
            </span>
        </div>
    }
</a>
