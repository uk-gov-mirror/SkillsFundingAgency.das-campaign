@model SFA.DAS.Campaign.Web.Models.ApprenticeshipTrainingAndBenefitsViewModel

<div class="fiu-article fiu-panel-form">

    @await Html.PartialAsync("_CalculationOutput", Model)

    @{
        if (Model.Roles > 1)
        {
            <p class="govuk-body">
                The number is based on your company having a pay bill of over £3 million, hiring @Model.Roles apprentices for @Model.CalculationResults.StandardTitle (Level @Model.CalculationResults.StandardLevel) over @Model.CalculationResults.StandardDuration months.
            </p>
        }
        else
        {
            <p class="govuk-body">
                The number is based on your company having a pay bill of over £3 million, hiring 1 apprentice for @Model.CalculationResults.StandardTitle (Level @Model.CalculationResults.StandardLevel) over @Model.CalculationResults.StandardDuration months.
            </p>
        }
    }

    <h2 class="govuk-heading-m">
        What you pay
    </h2>
    <p class="govuk-body">Just so you know, you’ll have to consider all other costs involved with hiring an apprentice, like how much you'll pay them. Apprentices must be paid at least the National Minimum Wage, with the exact rate depending on their age and the stage of their apprenticeship. For more information see <a class="govuk-link govuk-link--no-visited-state" target="_blank" href="https://www.gov.uk/employing-an-apprentice">employing an apprentice (opens in new tab)</a>.</p>

    <p class="govuk-body">If you’ve used all your levy funds, and you recruit an apprentice over 25, the government may pay 75% of the training costs. You’ll pay the remaining 25%. Find out more in the <a class="govuk-link govuk-link--no-visited-state" target="_blank" href="https://www.gov.uk/guidance/apprenticeship-funding-rules">apprenticeship funding rules (opens in a new tab)</a>. </p>
    <p class="govuk-body">Just a reminder: as of 1 August 2026, you have 12 months to use your levy funds after they enter your apprenticeship service account. After this point, the funds will expire. </p>
    @await Html.PartialAsync("_AdditionalFundingU25Levy", Model)
    @await Html.PartialAsync("_WhatToDoNext", Model)
</div>
