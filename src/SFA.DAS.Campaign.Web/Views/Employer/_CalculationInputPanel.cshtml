@using Microsoft.AspNetCore.Mvc.ModelBinding
@model SFA.DAS.Campaign.Web.Models.ApprenticeshipTrainingAndBenefitsViewModel

@{
    Func<string, bool> isInvalid = field => ViewData.ModelState[field]?.ValidationState == ModelValidationState.Invalid;
}

<div class="fiu-article fiu-panel-form">
    <h2 class="govuk-heading-l">Estimate the funding you can get</h2>
    <p>This tool can help you estimate what funding could be available towards your apprentice’s training costs, if they’re aged 25 or over. If you’re recruiting an apprentice aged under 25, the government will usually fund 100% of the training costs. </p>
    <form method="post" asp-action="ApprenticeshipBenefitsAndFunding" asp-controller="Employer" asp-fragment="funding">
        <div class="govuk-form-group" highlight-error-for="PayBillGreaterThanThreeMillion">
            <fieldset class="govuk-fieldset" aria-describedby="@(isInvalid("PayBillGreaterThanThreeMillion") ? "PayBillGreaterThanThreeMillion-error" : null)">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">What is your annual pay bill?</legend>
                <span id="PayBillGreaterThanThreeMillion-error" asp-validation-for="@Model.PayBillGreaterThanThreeMillion" class="govuk-error-message"></span>
                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="PayBillGreaterThanThreeMillion" name="PayBillGreaterThanThreeMillion" type="radio" value="@false" asp-for="@Model.PayBillGreaterThanThreeMillion">
                        <label class="govuk-label govuk-radios__label" for="PayBillGreaterThanThreeMillion">
                            Under &pound;3 million
                        </label>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="pay-bill-over" name="PayBillGreaterThanThreeMillion" type="radio" value="@true" asp-for="@Model.PayBillGreaterThanThreeMillion">
                        <label class="govuk-label govuk-radios__label" for="pay-bill-over">
                            Over &pound;3 million
                        </label>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="govuk-form-group" highlight-error-for="StandardUid">
            <label class="govuk-label govuk-label--m govuk-!-font-weight-bold" for="StandardUid">
                What course do you want your apprentice to take?
            </label>
            <span id="StandardUid-error" asp-validation-for="@Model.StandardUid" class="govuk-error-message"></span>
            <select class="govuk-select" aria-describedby="@(isInvalid("StandardUid") ? "StandardUid-error" : "")" asp-for="@Model.StandardUid" asp-items="@Model.StandardItems" data-fiu-autocomplete="true" id="StandardUid"><option label=" "></option></select>
        </div>
        <div class="govuk-form-group" highlight-error-for="NumberOfRoles">
            <label class="govuk-label govuk-label--m govuk-!-font-weight-bold" for="NumberOfRoles">
                How many roles do you have available for this apprenticeship?
            </label>
            <span id="NumberOfRoles-error" asp-validation-for="@Model.NumberOfRoles" class="govuk-error-message"></span>
            <div class="govuk-hint" id="NumberOfRolesHint">
                Enter the number of available roles
            </div>
            <input class="govuk-input govuk-input--width-3" aria-describedby="@(isInvalid("NumberOfRoles") ? "NumberOfRolesHint NumberOfRoles-error" : "NumberOfRolesHint")" name="NumberOfRoles" type="text" asp-for="@Model.NumberOfRoles" id="NumberOfRoles" inputmode="numeric">
        </div>
        <div class="govuk-button-group">
            <button class="fiu-button fiu-button--employers" type="submit">
                Calculate funding
            </button>
            @{
                var rnd = new Random();
                var num = rnd.Next(100, 999);
            }
            <a class="fiu-button fiu-button--employers fiu-button--outlined" href="/employers/understanding-apprenticeship-benefits-and-funding?reset=@num#funding">Reset</a>
        </div>
    </form>
</div>